# Origin of the Tentvaale Spring Boot backend. Server-side only: the browser
# never talks to it directly, it goes through this app's /api/* proxy
# (see next.config.ts).
API_ORIGIN=http://localhost:8080

# Where the UI gets its data: "mock" (default) runs standalone on seeded,
# browser-local data; "api" calls the real backend through the proxy above.
NEXT_PUBLIC_DATA_SOURCE=mock

# Google Maps key (Places API enabled). Powers the address search in the warehouse form; empty hides it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
